<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".tienda.DetallesTiendaActivity">

    <!-- AppBar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_color"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:title="My Store"
        android:titleTextColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="@string/my_tienda"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nombreTienda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre de la tienda"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/webAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Web Address"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/descripcionTienda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/tipoTienda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo de tienda"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/direccionTienda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dirección"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/ciudadTienda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ciudad"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/paisTienda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="País"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/nombreCourier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Courier"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>